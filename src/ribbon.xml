<?xml version="1.0" encoding="UTF-8"?>
<!--
  ILLXL ribbon tab (Office 2010+ customUI14).
  - Buttons:  tag = the macro to run; onAction=Rib_Action runs it.
              getScreentip shows the label plus the ACTIVE preset's shortcut.
  - Galleries: list the active preset's steps (formats, styles, colors,
              tags, presets). invalidateContentOnDrop re-reads them every
              time they open, so a preset switch shows up straight away.
  - image="x" = assets\icons\x.png (added by build.ps1); imageMso = Office icon.
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Rib_OnLoad">
  <ribbon>
    <tabs>
      <tab id="tabILLXL" label="ILLXL" keytip="IL">

        <!-- ============================== ILLXL ============================== -->
        <group id="gILLXL" label="ILLXL">
          <button id="btnSettings" label="Settings" size="large" image="logo_L" getSupertip="Rib_Supertip" tag="ShowSettings"
                  onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <gallery id="galPreset" label="Preset" size="large" image="presets_L" columns="1" showItemImage="false"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" screentip="Switch preset"
                   supertip="Switch every format, color and shortcut to another preset in one click.">
            <button id="btnPresetSettings" label="Manage presets..." imageMso="FormatCellsDialog"
                    tag="ShowSettings" onAction="Rib_Action"/>
          </gallery>
          <button id="btnPerf" label="Performance Mode" size="large" image="perf_L" getSupertip="Rib_Supertip" tag="TogglePerformanceMode"
                  onAction="Rib_Action" getScreentip="Rib_Screentip"/>
        </group>

        <!-- ============================== NUMBER ============================== -->
        <group id="gNumber" label="Number">
          <gallery id="galNum" label="Number" imageMso="CommaStyle" columns="1" showItemImage="false"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CycleNumberFormat"
                   getScreentip="Rib_Screentip"/>
          <gallery id="galCur" label="Currency" imageMso="AccountingFormat" columns="1" showItemImage="false"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CycleCurrencyFormat"
                   getScreentip="Rib_Screentip"/>
          <gallery id="galPct" label="Percent" imageMso="PercentStyle" columns="1" showItemImage="false"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CyclePercentFormat"
                   getScreentip="Rib_Screentip"/>
          <gallery id="galDate" label="Date" imageMso="DateAndTimeInsert" columns="1" showItemImage="false"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CycleDateFormat"
                   getScreentip="Rib_Screentip"/>
          <gallery id="galOther" label="Other" image="otherfmt" columns="1" showItemImage="false"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CycleOtherNumbers"
                   getScreentip="Rib_Screentip"/>
          <separator id="sepNum"/>
          <box id="boxNum1" boxStyle="horizontal">
            <button id="btnDecUp" imageMso="DecimalsIncrease" showLabel="false" label="Increase Decimals" getSupertip="Rib_Supertip" tag="IncreaseDecimal" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
            <button id="btnDecDn" imageMso="DecimalsDecrease" showLabel="false" label="Decrease Decimals" getSupertip="Rib_Supertip" tag="DecreaseDecimal" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
            <button id="btnSign" image="sign" showLabel="false" label="Toggle Sign" getSupertip="Rib_Supertip" tag="ToggleSign" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          </box>
          <box id="boxNum2" boxStyle="horizontal">
            <button id="btnScaleUp" image="scalediv" showLabel="false" label="Divide by 1,000" getSupertip="Rib_Supertip" tag="ScaleUp" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
            <button id="btnScaleDn" image="scalemul" showLabel="false" label="Multiply by 1,000" getSupertip="Rib_Supertip" tag="ScaleDown" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          </box>
          <box id="boxNum3" boxStyle="horizontal">
            <button id="btnDiv100" image="div100" showLabel="false" label="Divide by 100" getSupertip="Rib_Supertip" tag="DivideByHundred" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
            <button id="btnMul100" image="mul100" showLabel="false" label="Multiply by 100" getSupertip="Rib_Supertip" tag="MultiplyByHundred" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          </box>
        </group>

        <!-- ============================== STYLES ============================== -->
        <group id="gStyles" label="Styles">
          <button id="btnAutoColor" label="Auto-Color" size="large" image="autocolor_L" getSupertip="Rib_Supertip" tag="AutoColorSelection"
                  onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <gallery id="galInput" label="Input Style" size="large" image="inputstyle_L" columns="1" itemWidth="40" itemHeight="20"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label" getItemImage="Gal_Image"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CycleInputStyle"
                   getScreentip="Rib_Screentip"/>
          <gallery id="galHeader" label="Header Style" size="large" image="headerstyle_L" columns="1" itemWidth="40" itemHeight="20"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label" getItemImage="Gal_Image"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CycleHeaderStyle"
                   getScreentip="Rib_Screentip"/>
          <gallery id="galFill" label="Fill" imageMso="CellFillColorPicker" columns="2" itemWidth="40" itemHeight="20"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label" getItemImage="Gal_Image"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CycleFill" getScreentip="Rib_Screentip"/>
          <gallery id="galFontColor" label="Font Color" imageMso="FontColorPicker" columns="2" itemWidth="40" itemHeight="20"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label" getItemImage="Gal_Image"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CycleFontColor" getScreentip="Rib_Screentip"/>
          <gallery id="galFont" label="Font" imageMso="FontDialog" columns="1" showItemImage="false"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CycleFont" getScreentip="Rib_Screentip"/>
          <gallery id="galTab" label="Tab Color" image="tabcolor" columns="1" itemWidth="40" itemHeight="20"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label" getItemImage="Gal_Image"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CycleTabColor" getScreentip="Rib_Screentip"/>
          <separator id="sepStyles"/>
          <box id="boxSty1" boxStyle="horizontal">
            <button id="btnFontUp" imageMso="FontSizeIncrease" showLabel="false" label="Increase Font Size" getSupertip="Rib_Supertip" tag="IncreaseFontSize" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
            <button id="btnFontDn" imageMso="FontSizeDecrease" showLabel="false" label="Decrease Font Size" getSupertip="Rib_Supertip" tag="DecreaseFontSize" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
            <button id="btnCase" imageMso="ChangeCaseGallery" showLabel="false" label="Cycle Text Case" getSupertip="Rib_Supertip" tag="CycleTextCase" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          </box>
          <box id="boxSty2" boxStyle="horizontal">
            <button id="btnIndIn" imageMso="IndentIncrease" showLabel="false" label="Indent In" getSupertip="Rib_Supertip" tag="IndentIn" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
            <button id="btnIndOut" imageMso="IndentDecrease" showLabel="false" label="Indent Out" getSupertip="Rib_Supertip" tag="IndentOut" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
            <button id="btnCenter" imageMso="AlignCenter" showLabel="false" label="Center Across Selection" getSupertip="Rib_Supertip" tag="CenterAcrossSelection" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          </box>
          <box id="boxSty3" boxStyle="horizontal">
            <button id="btnStamp" imageMso="DateAndTimeInsert" showLabel="false" label="Insert Timestamp" getSupertip="Rib_Supertip" tag="InsertStaticNow" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          </box>
        </group>

        <!-- ============================== BORDERS ============================== -->
        <group id="gBorders" label="Borders">
          <button id="btnOutline" label="Outline + Inside" imageMso="BordersAll" getSupertip="Rib_Supertip" tag="BordersOutlineInside" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnSumBar" label="Sum Bar" imageMso="BorderTop" getSupertip="Rib_Supertip" tag="ApplySumBar" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnDblSum" label="Double Sum Bar" imageMso="BorderTopAndDoubleBottom" getSupertip="Rib_Supertip" tag="ApplyDoubleSumBar" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <menu id="mnuEdges" label="Edge Cycles" imageMso="BorderOutside">
            <button id="btnEdgeTop" label="Top Edge" imageMso="BorderTop" getSupertip="Rib_Supertip" tag="BorderTop" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
            <button id="btnEdgeBottom" label="Bottom Edge" imageMso="BorderBottom" getSupertip="Rib_Supertip" tag="BorderBottom" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
            <button id="btnEdgeLeft" label="Left Edge" imageMso="BorderLeft" getSupertip="Rib_Supertip" tag="BorderLeft" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
            <button id="btnEdgeRight" label="Right Edge" imageMso="BorderRight" getSupertip="Rib_Supertip" tag="BorderRight" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          </menu>
        </group>

        <!-- ============================== FORMULAS ============================== -->
        <group id="gFormulas" label="Formulas">
          <button id="btnCAGR" label="CAGR" image="cagr" getSupertip="Rib_Supertip" tag="InsertCAGR" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnPctChg" label="% Change" image="pctchg" getSupertip="Rib_Supertip" tag="InsertPercentChange" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnGrowth" label="Growth Rate" image="growth" getSupertip="Rib_Supertip" tag="ApplyGrowthRate" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnEqLeft" label="Equals Left" image="eqleft" getSupertip="Rib_Supertip" tag="EqualsLeft" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnQSum" label="Quick SUM" imageMso="AutoSum" getSupertip="Rib_Supertip" tag="InsertQuickSum" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnQAvg" label="Quick AVERAGE" imageMso="FunctionWizard" getSupertip="Rib_Supertip" tag="InsertQuickAverage" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
        </group>

        <!-- ============================== HEADERS & CHECKS ============================== -->
        <group id="gHeaders" label="Headers &amp;&amp; Checks">
          <button id="btnHeaders" label="Insert Headers" image="headers" getSupertip="Rib_Supertip" tag="InsertHeadersFromPrompt" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnVarHdr" label="Variance Headers" image="variance" getSupertip="Rib_Supertip" tag="InsertVarianceHeaders" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnZero" label="Zero-Check" image="zerocheck" getSupertip="Rib_Supertip" tag="ApplyZeroCheckCF" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnZeroClr" label="Clear Zero-Check" image="zeroclear" getSupertip="Rib_Supertip" tag="ClearZeroCheckCF" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
        </group>

        <!-- ============================== UNIT TAGS ============================== -->
        <group id="gTags" label="Unit Tags">
          <gallery id="galTagValue" label="Value" image="tagvalue" columns="3" showItemImage="false"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CycleUnitTag_Value_Uniform" getScreentip="Rib_Screentip"/>
          <gallery id="galTagDuration" label="Duration" image="tagduration" columns="2" showItemImage="false"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CycleUnitTag_Duration_Uniform" getScreentip="Rib_Screentip"/>
          <gallery id="galTagRate" label="Rate" image="tagrate" columns="2" showItemImage="false"
                   invalidateContentOnDrop="true" getItemCount="Gal_Count" getItemLabel="Gal_Label"
                   getItemScreentip="Gal_Screentip" onAction="Gal_Action" getSupertip="Rib_Supertip" tag="CycleUnitTag_Rate_Uniform" getScreentip="Rib_Screentip"/>
          <button id="btnTagRemove" label="Remove Tag" image="tagremove" getSupertip="Rib_Supertip" tag="RemoveUnitTag" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
        </group>

        <!-- ============================== MODEL TOOLS ============================== -->
        <group id="gModel" label="Model Tools">
          <button id="btnSendReady" label="Ready to Send" size="large" image="sendready_L" tag="SendReady" onAction="Rib_Action" getScreentip="Rib_Screentip" getSupertip="Rib_Supertip"/>
          <button id="btnHardcodes" label="Find Hardcodes" image="hardcodes" tag="AuditHardcodes" onAction="Rib_Action" getScreentip="Rib_Screentip" getSupertip="Rib_Supertip"/>
          <button id="btnInconsistent" label="Inconsistent Formulas" image="inconsist" tag="AuditInconsistent" onAction="Rib_Action" getScreentip="Rib_Screentip" getSupertip="Rib_Supertip"/>
          <button id="btnLinks" label="External Links" imageMso="EditLinks" tag="AuditExternalLinks" onAction="Rib_Action" getScreentip="Rib_Screentip" getSupertip="Rib_Supertip"/>
          <button id="btnIfError" label="IFERROR On/Off" image="iferror" tag="ToggleIfError" onAction="Rib_Action" getScreentip="Rib_Screentip" getSupertip="Rib_Supertip"/>
          <button id="btnRound" label="ROUND On/Off" image="roundfn" tag="ToggleRound" onAction="Rib_Action" getScreentip="Rib_Screentip" getSupertip="Rib_Supertip"/>
          <button id="btnIndex" label="Sheet Index" image="sheetindex" tag="BuildSheetIndex" onAction="Rib_Action" getScreentip="Rib_Screentip" getSupertip="Rib_Supertip"/>
        </group>

        <!-- ============================== TOOLS ============================== -->
        <group id="gTools" label="Tools">
          <button id="btnAbs" label="Absolute Refs" image="refabs" getSupertip="Rib_Supertip" tag="MakeRefsAbsolute" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnRel" label="Relative Refs" image="refrel" getSupertip="Rib_Supertip" tag="MakeRefsRelative" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnNextBlank" label="Next Blank" imageMso="GoTo" getSupertip="Rib_Supertip" tag="GoToNextBlank" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnNextErr" label="Next Error" imageMso="TraceError" getSupertip="Rib_Supertip" tag="GoToNextError" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnErrChk" label="Error Checking" imageMso="ErrorChecking" getSupertip="Rib_Supertip" tag="ToggleErrorChecking" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
          <button id="btnUpdates" label="Check for Updates" image="update" tag="CheckForUpdates" onAction="Rib_Action" getScreentip="Rib_Screentip" getSupertip="Rib_Supertip"/>
          <button id="btnCleanStyles" label="Clean Up Styles" image="cleanstyles" getSupertip="Rib_Supertip" tag="RemoveUnusedStyles" onAction="Rib_Action" getScreentip="Rib_Screentip"/>
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>
